FROM --platform=linux/arm64 python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create data directory
RUN mkdir -p data

# Make startup script executable
RUN chmod +x start.sh

# Debug: List all files in /app to see what's copied
RUN ls -la /app/

# Ensure start.sh exists and is executable
RUN ls -la start.sh && test -f start.sh && test -x start.sh

# Expose port
EXPOSE 5000

# Run the startup script which handles migrations and starts the app
CMD ["./start.sh"]