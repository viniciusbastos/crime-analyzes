FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create data directory
RUN mkdir -p data

# Debug: List contents after copy
RUN echo "Contents after COPY:" && ls -la

# Make startup script executable
RUN chmod +x start.sh

# Debug: Verify start.sh exists and is executable
RUN echo "Verifying start.sh:" && ls -la start.sh && test -x start.sh && echo "start.sh is executable" || echo "start.sh is not executable"

# Expose port
EXPOSE 5000

# Run the startup script which handles migrations and starts the app
CMD ["./start.sh"]