# Environment Variables Template
# Copy this file to .env for development or .env.production for production
# and fill in your actual values

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgresql://user:password@db:5432/crime_analysis
SQLALCHEMY_DATABASE_URI=sqlite:///instance/crime_analysis.db

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery (optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# PostgreSQL (for Docker)
POSTGRES_DB=crime_analysis
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Frontend
VITE_API_BASE_URL=http://localhost:5001

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret